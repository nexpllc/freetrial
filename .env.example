# Everything here has a working default baked into the source, pointing at the
# existing nexp-5 Shopify store and the shared Web3Forms inbox. You only need
# this file if you're moving the free trial line onto its own store or inbox.

# Shopify Storefront API — Settings > Apps > Develop apps > Storefront API
# Storefront tokens are public by design (they ship in the client bundle), but
# only grant the token the unauthenticated_write_checkouts scope it needs.
VITE_SHOPIFY_DOMAIN=nexp-5.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=
VITE_SHOPIFY_API_VERSION=2024-10

# Set this only if you go the discount-code route for the pair discount.
# An automatic discount configured in Shopify admin is the better option.
VITE_SHOPIFY_PAIR_DISCOUNT_CODE=

# Where the contact and spotted forms deliver. Free key at web3forms.com.
VITE_WEB3FORMS_KEY=
