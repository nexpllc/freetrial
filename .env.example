# Shopify Storefront API — Settings > Apps > Develop apps > Storefront API
# Both are safe to expose in client bundles (Storefront tokens are public by design),
# but only grant the token the unauthenticated_write_checkouts scope it needs.
VITE_SHOPIFY_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=
VITE_SHOPIFY_API_VERSION=2024-10
